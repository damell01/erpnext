# ── Database ────────────────────────────────────────────────────────────────
DB_ROOT_PASSWORD=change_me_strong_password

# ── Site ─────────────────────────────────────────────────────────────────────
# The Frappe site name — must match the folder created inside /sites
SITE_NAME=vortexbreaks.local

# Admin password for the ERPNext Administrator user
ADMIN_PASSWORD=change_me_admin_password

# ── Network ──────────────────────────────────────────────────────────────────
# Port to expose on the host (default 80)
HTTP_PORT=80

# ── Build ────────────────────────────────────────────────────────────────────
# Override to pin a specific vortex_ops git branch
# VORTEX_BRANCH=main
